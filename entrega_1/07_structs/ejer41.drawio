                </mxCell>
                <mxCell id="op1" value="1: Cargar&#10;agenda.clear()&#10;Leer cant (max 50)&#10;i=0 → i&lt;cant? → leer Persona → push_back → i++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="30" y="530" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="op2" value="2: Buscar tel. por nombre&#10;Leer nombre&#10;encontrado=false&#10;for p in agenda:&#10;  si p.nombre==nombre → imprimir p.telefono&#10;si !encontrado → 'No encontrado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="250" y="520" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="op3" value="3: Buscar nombre por tel.&#10;Leer telefono&#10;encontrado=false&#10;for p in agenda:&#10;  si p.telefono==tel → imprimir p.nombre&#10;si !encontrado → 'No encontrado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="520" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="op4" value="4: Modificar telefono&#10;Leer nombre&#10;for p in agenda:&#10;  si p.nombre==nombre →&#10;    leer p.telefono nuevo&#10;    imprimir 'Actualizado'&#10;    break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="690" y="520" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="op5" value="5: Agregar contacto&#10;agenda.size() &gt;= 50?&#10;  SI → 'Agenda llena'&#10;  NO → leer Persona&#10;        push_back&#10;        imprimir 'Agregado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="910" y="520" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="op6" value="6: Dar de baja&#10;Leer nombre&#10;remove_if(agenda, nombre)&#10;si encontrado → erase&#10;imprimir 'Dado de baja'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
