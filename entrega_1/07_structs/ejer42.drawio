    <diagram id="flowchart-ejer42" name="Page-1">
        <mxGraphModel dx="1985" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1800" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="inicio" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d4e6f1;strokeColor=#3498db;strokeWidth=2;fontStyle=bold;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="580" y="30" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="decl" value="struct Producto { nombre, codigoBarras, precio, enOferta }&#10;func calcularPrecioFinal(p): enOferta? precio*0.9 : precio&#10;vector gondola&#10;opcion = -1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="390" y="115" width="500" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="condWhile" value="opcion != 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5b7b1;strokeColor=#e74c3c;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="565" y="250" width="150" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="menu" value="Mostrar menu (1..7, 0=Salir)&#10;Leer opcion" style="parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#a9dfbf;strokeColor=#27ae60;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="790" y="263" width="230" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="decOp" value="opcion?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5b7b1;strokeColor=#e74c3c;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="800" y="385" width="130" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="op1" value="1: Cargar productos&#10;gondola.clear()&#10;Leer cant (max 50)&#10;i=0 → i&lt;cant? →&#10;  leer nombre, codBarras, precio, oferta&#10;  enOferta = (oferta=='s')&#10;  push_back → i++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="20" y="560" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="op2" value="2: Buscar por nombre&#10;Leer nombre&#10;encontrado=false&#10;for p in gondola:&#10;  si p.nombre==nombre →&#10;    imprimir calcularPrecioFinal(p)&#10;    encontrado=true&#10;si !encontrado → 'No encontrado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="225" y="555" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="op3" value="3: Buscar por codigo&#10;Leer codigo&#10;encontrado=false&#10;for p in gondola:&#10;  si p.codigoBarras==codigo →&#10;    imprimir nombre y precio&#10;    encontrado=true&#10;si !encontrado → 'No encontrado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="430" y="555" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="op4" value="4: Modificar precio&#10;Leer nombre&#10;for p in gondola:&#10;  si p.nombre==nombre →&#10;    leer p.precio nuevo&#10;    imprimir 'Actualizado'&#10;    break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="635" y="555" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="op5" value="5: Quitar producto&#10;Leer nombre&#10;remove_if(gondola, nombre)&#10;si encontrado → erase&#10;imprimir 'Quitado'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="840" y="570" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="op6" value="6: Contar en oferta&#10;cant = 0&#10;for p in gondola:&#10;  si p.enOferta → cant++&#10;imprimir cant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1045" y="555" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="op7" value="7: Pasar a Chango&#10;monto=0, ahorro=0&#10;for p in gondola:&#10;  precioFinal = calcularPrecioFinal(p)&#10;  monto += precioFinal&#10;  ahorro += p.precio - precioFinal&#10;imprimir monto y ahorro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="555" width="200" height="130" as="geometry"/>
                </mxCell>
